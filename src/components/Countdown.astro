---
import { wedding } from '../data/wedding';
---
<section class="countdown-section section-pad text-center" aria-labelledby="countdown-heading" data-countdown data-date={wedding.date}>
  <p class="eyebrow">Cada vez más cerca</p>
  <h2 id="countdown-heading">La espera también <em>es parte de la magia.</em></h2>
  <div class="countdown-grid" role="timer" aria-label="Tiempo restante hasta la ceremonia" aria-live="off" hidden>
    {['Días', 'Horas', 'Minutos', 'Segundos'].map((label, index) => <div class="countdown-unit"><span class="countdown-number" data-unit={index}>00</span><span class="eyebrow">{label}</span></div>)}
  </div>
  <p class="countdown-message">Nos encontramos el {wedding.dateLabel.toLowerCase()} a las {wedding.events[0].time} h.</p>
  <p class="countdown-footnote">Una fecha para guardar en el corazón.</p>
</section>
<script>import '../scripts/countdown';</script>
