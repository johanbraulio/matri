---
import { wedding } from '../data/wedding';
import Icon from './Icon.astro';
---
{wedding.music && <div class="music-control"><audio id="wedding-music" src={wedding.music.src} preload="none" loop></audio><button id="music-toggle" class="music-toggle" aria-label={`Reproducir ${wedding.music.title}`} aria-pressed="false" data-title={wedding.music.title}><Icon name="music" size={22} /><span>Música</span></button><p id="music-status" class="music-status" role="status"></p></div>}
<script>import '../scripts/music';</script>
