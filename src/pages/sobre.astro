---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import Welcome from '../components/Welcome.astro';
import OurStory from '../components/OurStory.astro';
import Countdown from '../components/Countdown.astro';
import EventDetails from '../components/EventDetails.astro';
import Timeline from '../components/Timeline.astro';
import Gallery from '../components/Gallery.astro';
import Closing from '../components/Closing.astro';
import MusicControl from '../components/MusicControl.astro';
import Envelope from '../components/Envelope.astro';
import { wedding } from '../data/wedding';
import '../styles/envelope.css';
---
<MainLayout edition="envelope">
  <Envelope />
  <div id="invitation-content" hidden>
    <main><Hero photo={wedding.closing} position="65% center" /><Welcome /><OurStory /><Countdown /><EventDetails /><Timeline /><Gallery /></main>
    <Closing />
  </div>
  <MusicControl autoStart={false} />
  <noscript><style is:inline>@layer theme{#invitation-content[hidden]{display:block!important}}.envelope-welcome{display:none!important}html[data-envelope="closed"]{overflow:auto!important}</style></noscript>
</MainLayout>


